{
    "name": "@asicupv/paella-opencast-skin",
    "version": "2.0.2",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/polimediaupv/paella-opencast"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "provenance": true
    },
    "exports": {
        ".": {
            "types": "./dist/types/paella-opencast-skin.es.d.ts",
            "import": "./dist/paella-opencast-skin.es.js",
            "require": "./dist/paella-opencast-skin.cjs.js"
        },
        "./opencast-paella-skin.css": {
            "import": "./dist/paella-opencast-skin.css",
            "require": "./dist/paella-opencast-skin.css"
        }
    },
    "files": [
        "dist/*",
        "README.md"
    ],
    "scripts": {
        "dev": "tsc && vite build --watch --emptyOutDir=false",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint src/",
        "lint:fix": "eslint --fix src/",
        "test": "vitest --run",
        "clean:build": "rimraf .turbo dist",
        "clean:deps": "rimraf node_modules"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.3.0"
    }
}
